# PipeGate 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# JWT 签名密钥（必须设置）
PIPEGATE_JWT_SECRET=change-me-to-something-secret

# JWT 算法列表（必须设置）
PIPEGATE_JWT_ALGORITHMS=["HS256"]

# 连接标识符（可选，用于生成特定 connection_id 的 token）
# PIPEGATE_CONNECTION_ID=my-connection-id

# 请求体大小上限（可选，默认 10MB）
# PIPEGATE_MAX_BODY_BYTES=10485760

# 请求队列深度上限（可选，默认 100）
# PIPEGATE_MAX_QUEUE_DEPTH=100

# Token 过期天数（可选，默认 36500 天，约 100 年）
# PIPEGATE_TOKEN_EXPIRY_DAYS=36500