# ── PipeGate client — environment variables ──────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env
# Read by docker-compose.client.yml via `env_file: [.env]`.

# Shared JWT secret — MUST match the server's PIPEGATE_JWT_SECRET.
# Used by `pipegate connect` to sign tokens locally (never sent to the server).
PIPEGATE_JWT_SECRET=change-me-to-something-secret

# Optional: override the Docker image used by docker-compose.client.yml.
# Defaults to pipegate:local (built via `scripts/start-tunnel-docker.sh build`).
# Set to a remote registry image to skip the local build step.
# IMAGE=registry.example.com/ns/pipegate:latest

# Optional: JWT algorithm list (must match server). Default: ["HS256"]
# Use single quotes so the inner double quotes survive `source .env` —
# pydantic-settings parses this as JSON, so it must stay ["HS256"] not [HS256].
# PIPEGATE_JWT_ALGORITHMS='["HS256"]'

# Optional: JWT issuer / audience — must match server exactly, or the server
# will reject the WebSocket with close code 1008. Defaults: pipegate / pipegate
# PIPEGATE_JWT_ISSUER=pipegate
# PIPEGATE_JWT_AUDIENCE=pipegate
